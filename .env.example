# Materialpool-Entwicklung — Konfigurationsvorlage
#
# Kopieren nach .env und ausfüllen. .env ist in .gitignore und gehört
# NICHT ins Repository. Relay- und Schlüsseladressen sind Konfiguration,
# nie Code (CLAUDE.md). Fehlt ein Pflichtwert, bricht der Start ab.


# ── Relays (Pflicht, komma-getrennt) ─────────────────────────────────────
# Die drei AMB-Relays von edufeed (kind:30142), wie im Prototyp
# Materialpool 2.0. Mehrere Relays werden parallel gefragt und nach
# Event-id zusammengeführt. Stand 30.09.2026 mit dem Fachfilter unten:
# amb-relay 7.736 (davon 7.701 Materialpool), sodix 645, oersi 14.
# Unverschlüsselt (ws://) geht nur für ein Mock-Relay auf 127.0.0.1 oder
# localhost — zum Prüfen des gebauten Servers ohne Netz (test/mock-relay.mjs).
RELAYS=wss://amb-relay.edufeed.org/,wss://sodix.edufeed.org/,wss://oersi.edufeed.org/


# ── Quelle (optional) ────────────────────────────────────────────────────
# Hex-Pubkeys, komma-getrennt. Leer heißt: alle kind:30142 der Relays bis
# SPIEGEL_LIMIT, eingegrenzt nur durch QUELLE_FAECHER. Leer, damit neben
# dem Materialpool-Bestand (Schlüssel 610df6d6…, ADR-0003) auch Religions-
# material anderer Anbieter erscheint — katholisch, überkonfessionell.
# Nur den Materialpool zeigen:
# QUELLE_AUTOREN=610df6d605ed2868153ca9b7dbc0786006419b5877497887eb1d39ebabe27ef1
QUELLE_AUTOREN=
# Hex-Pubkeys, komma-getrennt, in Reihenfolge des Vorrangs (ADR-0009).
# Dasselbe `d` (die Adresse /m/<d>) kann jeder Schlüssel publizieren; die
# Seite ohne ?von= zeigt dann das Event des ersten Schlüssels hier. Leer
# heißt: das früheste Event gilt — nie das jüngste. `created_at` setzt der
# Publizierende selbst, verlässlich ist also nur diese Liste. Materialpool
# zuerst:
# QUELLE_VORRANG=610df6d605ed2868153ca9b7dbc0786006419b5877497887eb1d39ebabe27ef1
QUELLE_VORRANG=
# Fächer als URIs, komma-getrennt — Filter `#about:id` der edufeed-AMB-
# Relays (ADR-0004). Leer heißt: kein Fachfilter. Hier alle KIM-Kennungen
# für Religion: evangelisch s1024, islamisch s1025, katholisch s1026,
# überkonfessionell s1055, alevitisch s1056, jüdisch s1057. Die Facette
# „Fach“ der Liste liest dieselben Kennungen.
QUELLE_FAECHER=http://w3id.org/kim/schulfaecher/s1024,http://w3id.org/kim/schulfaecher/s1025,http://w3id.org/kim/schulfaecher/s1026,http://w3id.org/kim/schulfaecher/s1055,http://w3id.org/kim/schulfaecher/s1056,http://w3id.org/kim/schulfaecher/s1057


# ── Spiegel ──────────────────────────────────────────────────────────────
# Jede Anfrage rendert aus dem Spiegel, nie direkt vom Relay. Die Datei
# hält den letzten gültigen Stand über Neustarts.
SPIEGEL_PFAD=daten/spiegel.json
SPIEGEL_INTERVALL_S=600
SPIEGEL_STARTWARTEZEIT_S=20
# Höchstzahl Events je Relay insgesamt. Das Relay liefert je Anfrage
# höchstens 250; der Spiegel blättert über `until`, bis alles da ist.
SPIEGEL_LIMIT=10000


# ── Vorschaubilder ───────────────────────────────────────────────────────
# Bilder der Materialien kommen von fremden Servern (e-teaching.org,
# YouTube …): Jeder Aufruf verrät dort die IP-Adresse, und Rechte an
# Personenfotos sind ungeklärt. Darum aus, bis das geklärt ist — die
# Karten zeigen dann die farbige Fläche mit Typ-Symbol. „an“ zeigt sie.
VORSCHAUBILDER=aus


# ── Link-Prüfung (ADR-0010) ──────────────────────────────────────────────
# Der Server fragt die Links der Materialien im Hintergrund an. Melden sie
# zweimal hintereinander 404 oder 410, verschwindet das Material aus Liste,
# Suche und Startseite; antworten sie wieder, kommt es zurück. „aus“
# schaltet die Prüfung ab (nichts wird ausgeblendet).
LINKPRUEFUNG=an
LINKPRUEFUNG_PFAD=daten/linkpruefung.json
# Abstand, in dem jeder Link erneut geprüft wird (Standard: 7 Tage).
LINKPRUEFUNG_INTERVALL_S=604800
# Alle LINKPRUEFUNG_TAKT_S Sekunden werden LINKPRUEFUNG_JE_TAKT Links
# nacheinander geprüft — 20 je Minute schaffen 8.400 Links in sieben Stunden.
LINKPRUEFUNG_TAKT_S=60
LINKPRUEFUNG_JE_TAKT=20


# ── Meldungen (ADR-0011) ─────────────────────────────────────────────────
# Auf jeder Detailseite kann man melden, dass etwas nicht stimmt. Eine
# Meldung setzt einen Hinweis, ab zwei ist das Material ausgeblendet, bis
# die Redaktion unter /redaktion entscheidet. „aus“ schaltet die Meldefunktion ab.
MELDUNGEN=an
MELDUNGEN_PFAD=daten/meldungen.json
# Höchstzahl Meldungen in 24 Stunden, gegen Spam.
MELDUNGEN_JE_TAG=30
# Kennwort für /redaktion. Leer heißt: Die Seite ist offen (Prototyp).
REDAKTION_KENNWORT=


# ── E-Mail an die Redaktion (ADR-0011) ───────────────────────────────────
# Ohne MAIL_VERSAND=an steht jede E-Mail nur im Protokoll des Servers.
# Mit „an“ sind MAIL_AN, MAIL_VON und SMTP_HOST Pflicht.
MAIL_VERSAND=aus
MAIL_AN=
MAIL_VON=
SMTP_HOST=
# 587 (STARTTLS) oder 465 (verschlüsselt von Anfang an)
SMTP_PORT=587
SMTP_BENUTZER=
SMTP_KENNWORT=


# ── Umgebung ─────────────────────────────────────────────────────────────
# lokal | dev
UMGEBUNG=lokal


# ── Gebauter Server (adapter-node, nicht für `pnpm dev`) ─────────────────
# Die öffentliche Adresse. SvelteKit weist ein Formular per POST (/konto)
# mit 403 ab, wenn dessen Origin nicht zu dieser Adresse passt; ohne ORIGIN
# rät adapter-node https://<Host-Kopfzeile> — hinter Apache meist falsch
# (docs/betrieb.md). Alternative: PROTOCOL_HEADER=x-forwarded-proto und
# HOST_HEADER=x-forwarded-host, wenn der Proxy beide setzt. Cookies sind
# Secure, außer auf http://localhost: über http://<IP>:8080 bleibt keine
# Anmeldung und keine Farbe hängen.
# ORIGIN=https://material.rpi-virtuell.net
